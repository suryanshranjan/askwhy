{
  "name": "askwhy",
  "version": "0.1.1",
  "description": "git blame tells you who. git why tells you why. Per-hunk provenance for agent-written code: decision, rejected alternatives, prompt, proof, price.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "askwhy": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test --import tsx \"tests/*.test.ts\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "provenance",
    "claude-code",
    "codex",
    "coding-agents",
    "agent-trace",
    "blame"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "author": "Suryansh Ranjan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suryanshranjan/askwhy.git"
  },
  "bugs": {
    "url": "https://github.com/suryanshranjan/askwhy/issues"
  },
  "homepage": "https://github.com/suryanshranjan/askwhy#readme"
}
